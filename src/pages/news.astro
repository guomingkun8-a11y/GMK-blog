---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
---

<Layout title="新闻 | 郭明坤" description="郭明坤关注的新闻——值得关注的社会动态与热点。">
  <SiteHeader />

  <main class="page" id="top">
    <div class="page__inner">
      <section class="page__hero" data-reveal>
        <p class="page__eyebrow">新闻</p>
        <h1 class="page__title">
          值得关注的，<br />
          都在<em>这里</em>。
        </h1>
        <p class="page__lead" data-reveal>
          记录我关注的社会动态和热点。内容正在整理。
        </p>
      </section>

      <section class="page__body">
        <div class="page__empty" data-reveal>
          <p>新闻内容整理中，敬请期待。</p>
        </div>
      </section>
    </div>
  </main>

  <footer class="site-footer">
    <div class="site-footer__inner">
      <p>© {new Date().getFullYear()} 郭明坤</p>
      <a class="site-footer__back" href="#top">回到顶部 ↑</a>
    </div>
  </footer>

  <script is:inline src={`${import.meta.env.BASE_URL}/chat.js`}></script>
</Layout>
