---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { getCollection } from "astro:content";
import { noteCategories } from "../data/notes";
import { resolveNote, displayDate, isoDate } from "../lib/resolveNote";

// 首页：巨型刊头 + 文章卡片网格 + 右侧边栏
const allNotes = await getCollection("notes").then((notes) =>
  notes.map((entry) => resolveNote(entry))
);
const sorted = allNotes.sort((a, b) => b.date.getTime() - a.date.getTime());
const latest = sorted.slice(0, 6);
const latestForSidebar = sorted.slice(0, 4);

const base = import.meta.env.BASE_URL;
const basePath = base.replace(/\/$/, "");
const noteHref = (category: string, slug: string) =>
  `${basePath}/notes/${category}/${slug}`;
// 封面路径：base 和 cover 都可能带斜杠，规范化避免出现 // 开头（会被当成协议相对地址）
const coverSrc = (cover: string) => `${basePath}/${cover.replace(/^\//, "")}`;
---

<Layout>
  <SiteHeader />

  <main class="home" id="top">
    <div class="home__inner">
      <!-- 刊头：巨型标题，整行压住页面 -->
      <header class="home__masthead" data-reveal>
        <h1 class="home__masthead-title">Guomingkun's Blog</h1>
        <p class="home__masthead-sub">记录技术，也记录生活。</p>
      </header>

      <div class="home__layout">
        <!-- 左侧：文章卡片网格 -->
        <div class="home__main">
          {latest.length === 0 && (
            <p class="page__empty">还没有文章，去 content/notes 目录里放一篇 Markdown 试试。</p>
          )}
          <div class="home__post-grid">
            {latest.map((note) => (
              <article class="post-card" data-reveal>
                <a class="post-card__link" href={noteHref(note.category.id, note.slug)}>
                  {note.cover && (
                    <span class="post-card__cover">
                      <img src={coverSrc(note.cover)} alt="" loading="lazy" />
                    </span>
                  )}
                  <span class="post-card__cat">{note.category.name}</span>
                  <h2 class="post-card__title">{note.title}</h2>
                  {note.summary && <p class="post-card__summary">{note.summary}</p>}
                  <time class="post-card__date" datetime={isoDate(note.date)}>
                    {displayDate(note.date)}
                  </time>
                </a>
              </article>
            ))}
          </div>
          <a class="home__archive" href={`${basePath}/notes`} data-reveal>
            查看全部文章 →
          </a>
        </div>

        <!-- 右侧边栏 -->
        <aside class="home__sidebar">
          <section class="side-block" data-reveal>
            <h2 class="side-block__title">分类</h2>
            <ul class="side-list">
              {noteCategories.map((category) => (
                <li>
                  <a href={`${basePath}/notes/${category.id}`}>{category.name}</a>
                </li>
              ))}
            </ul>
          </section>

          <section class="side-block" data-reveal>
            <h2 class="side-block__title">最新文章</h2>
            <ul class="side-posts">
              {latestForSidebar.map((note) => (
                <li>
                  <a href={noteHref(note.category.id, note.slug)}>
                    <span class="side-posts__title">{note.title}</span>
                    <time datetime={isoDate(note.date)}>{displayDate(note.date)}</time>
                  </a>
                </li>
              ))}
            </ul>
          </section>

          <section class="side-block" data-reveal>
            <h2 class="side-block__title">关于</h2>
            <p class="side-about">
              软件开发工程师，写代码、做 AI 应用，也记生活。
            </p>
            <a class="side-about__link" href={`${basePath}/about`}>关于我 →</a>
          </section>
        </aside>
      </div>
    </div>
  </main>

  <footer class="site-footer">
    <div class="site-footer__inner">
      <p>© {new Date().getFullYear()} 郭明坤</p>
      <a class="site-footer__back" href="#top">回到顶部 ↑</a>
    </div>
  </footer>
</Layout>
