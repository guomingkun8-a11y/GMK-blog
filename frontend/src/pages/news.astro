---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { getNews, timeAgo } from "../lib/news";

const { items, fetchedAt } = await getNews();
const hasNews = items.length > 0;
// 按时间分组（今天 / 更早）
const todayKey = new Date().toDateString();
---

<Layout title="新闻 | 郭明坤" description="郭明坤关注的科技与 AI 新闻——来自 Hacker News 的热门动态。">
  <SiteHeader />

  <main class="page" id="top">
    <div class="page__inner">
      <section class="page__hero" data-reveal>
        <p class="page__eyebrow">新闻</p>
        <h1 class="page__title">
          值得关注的，<br />
          都在<em>这里</em>。
        </h1>
        <p class="page__lead" data-reveal>
          聚合 Hacker News 上的热门科技与 AI 动态，实时更新。
        </p>
      </section>

      <section class="page__body page__body--wide">
        {
          hasNews ? (
            <div class="news">
              <div class="news__head" data-reveal>
                <span class="news__src">数据源 · Hacker News Top Stories</span>
                <span class="news__updated">
                  更新于 {new Date(fetchedAt).toLocaleString("zh-CN", { hour12: false })}
                </span>
              </div>

              <ul class="news__list">
                {items.map((item, i) => (
                  <li class="news__item" data-reveal>
                    <a class="news__link" href={item.link} target="_blank" rel="noopener noreferrer">
                      <span class="news__rank">{String(i + 1).padStart(2, "0")}</span>
                      <span class="news__main">
                        <span class="news__title">{item.title}</span>
                        <span class="news__meta">
                          {item.points} 赞 · {item.comments} 评论 · @{item.author} · {timeAgo(item.created_at)}
                        </span>
                      </span>
                      <span class="news__arrow">↗</span>
                    </a>
                  </li>
                ))}
              </ul>

              <p class="news__note" data-reveal>
                数据来自 Hacker News 官方接口，点击标题可跳转原文；无原文的条目会进入 HN 讨论页。
              </p>
            </div>
          ) : (
            <div class="page__empty" data-reveal>
              <p>暂时没能拉取到新闻数据，稍后刷新试试。</p>
            </div>
          )
        }
      </section>
    </div>
  </main>

  <footer class="site-footer">
    <div class="site-footer__inner">
      <p>© {new Date().getFullYear()} 郭明坤</p>
      <a class="site-footer__back" href="#top">回到顶部 ↑</a>
    </div>
  </footer>

  <script is:inline src={`${import.meta.env.BASE_URL}/chat.js`}></script>
</Layout>
