---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader.astro";
---

<Layout title="联系 | 郭明坤" description="联系郭明坤——邮箱、GitHub、CSDN，欢迎来信交流。">
  <SiteHeader />

  <main class="page" id="top">
    <div class="page__inner">
      <section class="page__hero" data-reveal>
        <p class="page__eyebrow">联系我</p>
        <h1 class="page__title">
          有话想说，<br />
          随时<em>来聊</em>。
        </h1>
        <p class="page__lead" data-reveal>
          技术交流、合作想法，或者看完某篇想聊两句，都欢迎。选个你顺手的渠道。
        </p>
      </section>

      <section class="page__body">
        <address class="page__contact" aria-label="个人联系方式">
          <a class="page__contact-item" href="mailto:guomingkun8@gmail.com" data-reveal>
            <span class="page__contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            </span>
            <span class="page__contact-body">
              <span class="page__contact-label">Email</span>
              <span class="page__contact-value">guomingkun8@gmail.com</span>
            </span>
            <span class="page__contact-arrow">→</span>
          </a>
          <a class="page__contact-item" href="https://github.com/helloGMK" target="_blank" rel="noopener" data-reveal>
            <span class="page__contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.78 1.05.78 2.12 0 1.53-.01 2.76-.01 3.14 0 .31.21.67.8.56A11.52 11.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
            </span>
            <span class="page__contact-body">
              <span class="page__contact-label">GitHub</span>
              <span class="page__contact-value">github.com/helloGMK</span>
            </span>
            <span class="page__contact-arrow">→</span>
          </a>
          <a class="page__contact-item" href="https://blog.csdn.net/gmk20011104" target="_blank" rel="noopener" data-reveal>
            <span class="page__contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v12H8l-4 4z"/></svg>
            </span>
            <span class="page__contact-body">
              <span class="page__contact-label">CSDN</span>
              <span class="page__contact-value">blog.csdn.net/gmk20011104</span>
            </span>
            <span class="page__contact-arrow">→</span>
          </a>
          <a class="page__contact-item" href="mailto:3317099646@qq.com" data-reveal>
            <span class="page__contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 20 9-5-9-5-9 5z"/><path d="m3 15 9 5 9-5"/></svg>
            </span>
            <span class="page__contact-body">
              <span class="page__contact-label">QQ 邮箱</span>
              <span class="page__contact-value">3317099646@qq.com</span>
            </span>
            <span class="page__contact-arrow">→</span>
          </a>
        </address>
      </section>
    </div>
  </main>

  <footer class="site-footer">
    <div class="site-footer__inner">
      <p>© {new Date().getFullYear()} 郭明坤</p>
      <a class="site-footer__back" href="#top">回到顶部 ↑</a>
    </div>
  </footer>

  <script is:inline src={`${import.meta.env.BASE_URL}chat.js`}></script>
</Layout>
