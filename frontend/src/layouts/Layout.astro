---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "郭明坤 | 个人博客",
  description = "郭明坤的个人博客，记录工作、学习、生活与社会讨论。",
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <link
      rel="icon"
      type="image/png"
      href={`${import.meta.env.BASE_URL}avatar.png`}
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script is:inline set:html={`window.__GMK_BASE__ = ${JSON.stringify(import.meta.env.BASE_URL)};`}></script>
    <script is:inline defer src={`${import.meta.env.BASE_URL}header-scroll.js`}></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />

    {!Astro.url.pathname.replace(/\/$/, "").endsWith("/chat") && (
      <script is:inline src={`${import.meta.env.BASE_URL}reveal.js`} />
    )}
  </body>
</html>
