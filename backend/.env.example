# 复制本文件为 .env 并填写真实值（.env 已被 gitignore，不会提交）
SERPAPI_KEY=你的_serpapi_key
FRONTEND_ORIGINS=http://localhost:4321
CACHE_TTL_SECONDS=300
SERPAPI_LANGUAGE=zh-cn
SERPAPI_COUNTRY=cn

# AI 对话接口（仅配置在后端，不要使用 PUBLIC_ 前缀）
AI_API_KEY=你的_openrouter_key
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openrouter/free
AI_FALLBACK_MODEL=openrouter/free
AI_SITE_NAME=GMK Blog
AI_SYSTEM_PROMPT=你是郭明坤个人博客的 AI 小助手。只根据明确提供的个人资料回答，不确定的信息禁止编造。
